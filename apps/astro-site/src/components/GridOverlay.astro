---
// Interactive Dev Grid Overlay for The Peak
if (!import.meta.env.DEV) {
  return;
}
---

<div id="thepeak-grid-overlay" class="grid-overlay" aria-hidden="true">
  <!-- Container boundary guides -->
  <div class="grid-overlay-margins"></div>

  <!-- Main 12-Column Swiss Grid inside Container -->
  <div class="grid-overlay-container swiss-grid">
    {Array.from({ length: 12 }).map((_, i) => (
      <div class="grid-col" data-col={i + 1}>
        <span class="col-num top">{i + 1}</span>
        <span class="col-num bottom">{i + 1}</span>
      </div>
    ))}
  </div>

  <!-- Horizontal baseline grid (optional layer) -->
  <div class="grid-baseline" id="grid-baseline-layer"></div>

  <!-- Center axis line -->
  <div class="grid-center-axis"></div>
</div>

<!-- Floating HUD Toolbar -->
<div class="grid-hud" id="thepeak-grid-hud">
  <!-- Minimized trigger button -->
  <button
    type="button"
    class="grid-hud-toggle"
    id="grid-hud-toggle-btn"
    title="Показать/скрыть сетку (Горячая клавиша: G)"
    aria-label="Сетка: переключить оверлей"
  >
    <svg class="grid-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="0"></rect>
      <line x1="9" y1="3" x2="9" y2="21"></line>
      <line x1="15" y1="3" x2="15" y2="21"></line>
      <line x1="3" y1="9" x2="21" y2="9"></line>
      <line x1="3" y1="15" x2="21" y2="15"></line>
    </svg>
    <span class="hud-label">Сетка</span>
    <span class="hud-indicator" id="hud-status-dot"></span>
  </button>

  <!-- Expanded Controls Panel -->
  <div class="grid-hud-panel" id="grid-hud-panel">
    <div class="hud-header">
      <div class="hud-title-group">
        <strong class="hud-title">Сетка и Направляющие</strong>
        <span class="hud-badge" id="hud-breakpoint-tag">Desktop</span>
      </div>
      <button type="button" class="hud-close-btn" id="hud-close-panel-btn" title="Свернуть панель" aria-label="Свернуть">
        ×
      </button>
    </div>

    <div class="hud-stats">
      <div class="stat-item">
        <span class="stat-label">Вьюпорт</span>
        <span class="stat-value" id="hud-viewport-size">1440 × 900</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Сетка (Swiss Grid)</span>
        <span class="stat-value" id="hud-container-size">12 колонок</span>
      </div>
    </div>

    <div class="hud-toggles">
      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-columns" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">12 Колонок</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-container-outline" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">Поля страницы</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-baseline" />
        <span class="custom-check"></span>
        <span class="toggle-text">Базовая сетка (24px)</span>
      </label>

      <label class="hud-toggle-item">
        <input type="checkbox" id="toggle-center-axis" checked />
        <span class="custom-check"></span>
        <span class="toggle-text">Центральная ось</span>
      </label>
    </div>

    <div class="hud-opacity">
      <div class="opacity-header">
        <span>Прозрачность</span>
        <span id="opacity-val-label">50%</span>
      </div>
      <input type="range" id="grid-opacity-range" min="10" max="100" value="50" step="5" />
    </div>

    <div class="hud-footer">
      <span class="hud-hint">Клавиша <kbd>G</kbd> — вкл/выкл сетку</span>
    </div>
  </div>
</div>

<script>
  function initGridOverlay() {
    const overlay = document.getElementById('thepeak-grid-overlay');
    const hud = document.getElementById('thepeak-grid-hud');
    const toggleBtn = document.getElementById('grid-hud-toggle-btn');
    const closePanelBtn = document.getElementById('hud-close-panel-btn');
    const statusDot = document.getElementById('hud-status-dot');
    const viewportSizeEl = document.getElementById('hud-viewport-size');
    const breakpointTagEl = document.getElementById('hud-breakpoint-tag');
    const containerSizeEl = document.getElementById('hud-container-size');

    const toggleCols = document.getElementById('toggle-columns') as HTMLInputElement | null;
    const toggleOutline = document.getElementById('toggle-container-outline') as HTMLInputElement | null;
    const toggleBaseline = document.getElementById('toggle-baseline') as HTMLInputElement | null;
    const toggleAxis = document.getElementById('toggle-center-axis') as HTMLInputElement | null;
    const opacityRange = document.getElementById('grid-opacity-range') as HTMLInputElement | null;
    const opacityLabel = document.getElementById('opacity-val-label');

    if (!overlay || !hud || !toggleBtn) return;

    // Prevent double listener bindings if re-run on transitions
    if ((toggleBtn as any).__peakGridBound) {
      return;
    }
    (toggleBtn as any).__peakGridBound = true;

    // Load saved settings
    const STORAGE_KEY = 'thepeak_grid_settings';
    let settings = {
      visible: false,
      panelOpen: false,
      columns: true,
      outline: true,
      baseline: false,
      axis: true,
      opacity: 50,
    };

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        settings = { ...settings, ...JSON.parse(saved) };
      }
    } catch (e) {
      // ignore JSON parse error
    }

    function saveSettings() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
      } catch (e) {}
    }

    function applyState() {
      overlay?.classList.toggle('is-active', settings.visible);
      statusDot?.classList.toggle('is-active', settings.visible);
      hud?.classList.toggle('is-panel-open', settings.panelOpen);

      overlay?.classList.toggle('hide-columns', !settings.columns);
      overlay?.classList.toggle('hide-outline', !settings.outline);
      overlay?.classList.toggle('show-baseline', settings.baseline);
      overlay?.classList.toggle('hide-axis', !settings.axis);

      overlay?.style.setProperty('--grid-opacity', (settings.opacity / 100).toString());

      if (toggleCols) toggleCols.checked = settings.columns;
      if (toggleOutline) toggleOutline.checked = settings.outline;
      if (toggleBaseline) toggleBaseline.checked = settings.baseline;
      if (toggleAxis) toggleAxis.checked = settings.axis;
      if (opacityRange) opacityRange.value = settings.opacity.toString();
      if (opacityLabel) opacityLabel.textContent = `${settings.opacity}%`;
    }

    function updateViewportInfo() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      if (viewportSizeEl) {
        viewportSizeEl.textContent = `${w}px × ${h}px (${(w / 16).toFixed(1)}rem)`;
      }

      if (breakpointTagEl) {
        if (w >= 1280) {
          breakpointTagEl.textContent = 'Desktop XL (≥1280)';
          breakpointTagEl.className = 'hud-badge is-desktop';
        } else if (w >= 1024) {
          breakpointTagEl.textContent = 'Laptop LG (≥1024)';
          breakpointTagEl.className = 'hud-badge is-desktop';
        } else if (w >= 768) {
          breakpointTagEl.textContent = 'Tablet MD (≥768)';
          breakpointTagEl.className = 'hud-badge is-tablet';
        } else if (w >= 640) {
          breakpointTagEl.textContent = 'Small SM (≥640)';
          breakpointTagEl.className = 'hud-badge is-tablet';
        } else {
          breakpointTagEl.textContent = 'Mobile (<640)';
          breakpointTagEl.className = 'hud-badge is-mobile';
        }
      }

      if (containerSizeEl) {
        containerSizeEl.textContent = '12 col (Swiss Grid)';
      }
    }

    // Toggle overlay visibility
    function toggleGridVisibility() {
      settings.visible = !settings.visible;
      // If opening for first time, open panel as well
      if (settings.visible && !settings.panelOpen) {
        settings.panelOpen = true;
      }
      applyState();
      saveSettings();
    }

    toggleBtn.addEventListener('click', () => {
      if (!settings.visible) {
        settings.visible = true;
        settings.panelOpen = true;
      } else {
        settings.panelOpen = !settings.panelOpen;
      }
      applyState();
      saveSettings();
    });

    closePanelBtn?.addEventListener('click', () => {
      settings.panelOpen = false;
      applyState();
      saveSettings();
    });

    // Sub-toggles
    toggleCols?.addEventListener('change', () => {
      settings.columns = toggleCols.checked;
      applyState();
      saveSettings();
    });

    toggleOutline?.addEventListener('change', () => {
      settings.outline = toggleOutline.checked;
      applyState();
      saveSettings();
    });

    toggleBaseline?.addEventListener('change', () => {
      settings.baseline = toggleBaseline.checked;
      applyState();
      saveSettings();
    });

    toggleAxis?.addEventListener('change', () => {
      settings.axis = toggleAxis.checked;
      applyState();
      saveSettings();
    });

    opacityRange?.addEventListener('input', () => {
      settings.opacity = Number(opacityRange.value);
      applyState();
      saveSettings();
    });

    // Keyboard shortcut 'G' or Cyrillic 'П'
    window.addEventListener('keydown', (e) => {
      // Avoid triggering when user is typing in form inputs
      const target = e.target as HTMLElement;
      if (
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.tagName === 'SELECT' ||
        target.isContentEditable
      ) {
        return;
      }

      if (e.key === 'g' || e.key === 'G' || e.key === 'п' || e.key === 'П') {
        if (!e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          toggleGridVisibility();
        }
      }
    });

    // Update on resize
    window.addEventListener('resize', updateViewportInfo);
    updateViewportInfo();
    applyState();
  }

  if (import.meta.env.DEV) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGridOverlay);
    } else {
      initGridOverlay();
    }
    document.addEventListener('astro:page-load', initGridOverlay);
  }
</script>

<style>
  :root {
    --grid-guide-color: #fd4b32;
    --grid-guide-col-bg: rgba(253, 75, 50, 0.08);
    --grid-guide-border: rgba(253, 75, 50, 0.25);
    --grid-guide-outline: rgba(253, 75, 50, 0.45);
    --grid-opacity: 0.5;
  }

  /* ---------------- Grid Overlay (Fixed) ---------------- */
  .grid-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    display: none;
    opacity: var(--grid-opacity);
    transition: opacity 0.15s ease;
  }

  .grid-overlay.is-active {
    display: block;
  }

  /* Side safety margin guides */
  .grid-overlay-margins {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    border-left: var(--page-margin, clamp(1rem, 3vw, 4rem)) solid rgba(253, 75, 50, 0.04);
    border-right: var(--page-margin, clamp(1rem, 3vw, 4rem)) solid rgba(253, 75, 50, 0.04);
  }

  .grid-overlay.hide-outline .grid-overlay-margins {
    border-color: transparent !important;
  }

  /* Main Container Box aligned to swiss-grid */
  .grid-overlay-container {
    height: 100%;
    position: relative;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns, 12), minmax(0, 1fr));
    gap: var(--grid-gap, clamp(0.5rem, 1vw, 1.5rem));
    padding-inline: var(--page-margin, clamp(1rem, 3vw, 4rem));
  }

  .grid-overlay.hide-columns .grid-overlay-container {
    display: none;
  }

  .grid-col {
    position: relative;
    height: 100%;
    background: var(--grid-guide-col-bg);
    border-left: 1px solid var(--grid-guide-border);
    border-right: 1px solid var(--grid-guide-border);
    box-sizing: border-box;
  }

  .col-num {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: inherit;
    font-size: 0.65rem;
    font-weight: 700;
    color: #fd4b32;
    background: rgba(255, 255, 255, 0.9);
    padding: 0.15rem 0.35rem;
    line-height: 1;
    border: 1px solid var(--grid-guide-border);
  }

  .col-num.top {
    top: 0.75rem;
  }

  .col-num.bottom {
    bottom: 0.75rem;
  }

  /* Baseline Horizontal Grid */
  .grid-baseline {
    position: absolute;
    inset: 0;
    display: none;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 23px,
      rgba(253, 75, 50, 0.2) 24px
    );
    background-size: 100% 24px;
    pointer-events: none;
  }

  .grid-overlay.show-baseline .grid-baseline {
    display: block;
  }

  /* Center Axis Line */
  .grid-center-axis {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: #2563eb;
    box-shadow: 0 0 4px rgba(37, 99, 235, 0.5);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .grid-overlay.hide-axis .grid-center-axis {
    display: none;
  }

  /* ---------------- Floating HUD Control Panel ---------------- */
  .grid-hud {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 10000;
    font-family: inherit;
  }

  /* Trigger Button */
  .grid-hud-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.95rem;
    background: rgba(26, 26, 26, 0.94);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: all 0.18s ease;
    user-select: none;
  }

  .grid-hud-toggle:hover {
    background: #000000;
    border-color: rgba(253, 75, 50, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
  }

  .grid-icon {
    width: 1rem;
    height: 1rem;
    color: #fd4b32;
  }

  .hud-label {
    letter-spacing: 0.02em;
  }

  .hud-indicator {
    width: 7px;
    height: 7px;
    background: #737373;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }

  .hud-indicator.is-active {
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  /* Controls Panel */
  .grid-hud-panel {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    right: 0;
    width: 19rem;
    max-width: calc(100vw - 2rem);
    background: rgba(22, 22, 23, 0.96);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #f2f2f2;
    padding: 1.25rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    display: none;
    flex-direction: column;
    gap: 1.1rem;
    animation: hudSlideUp 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .grid-hud.is-panel-open .grid-hud-panel {
    display: flex;
  }

  @keyframes hudSlideUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hud-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hud-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hud-title {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .hud-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .hud-badge.is-desktop {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .hud-badge.is-tablet {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .hud-badge.is-mobile {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .hud-close-btn {
    background: transparent;
    border: none;
    color: #888;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    transition: color 0.15s ease;
  }

  .hud-close-btn:hover {
    color: #ffffff;
  }

  /* Stats Block */
  .hud-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    background: rgba(0, 0, 0, 0.35);
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888888;
  }

  .stat-value {
    font-size: 0.76rem;
    font-weight: 600;
    color: #e5e5e5;
  }

  /* Toggles List */
  .hud-toggles {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .hud-toggle-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8rem;
    cursor: pointer;
    user-select: none;
    color: #d1d1d1;
    transition: color 0.12s ease;
  }

  .hud-toggle-item:hover {
    color: #ffffff;
  }

  .hud-toggle-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .custom-check {
    width: 0.95rem;
    height: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
    position: relative;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .hud-toggle-item input:checked + .custom-check {
    background: #fd4b32;
    border-color: #fd4b32;
  }

  .hud-toggle-item input:checked + .custom-check::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 1px;
    width: 3px;
    height: 6px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Opacity slider */
  .hud-opacity {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .opacity-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #888888;
  }

  .hud-opacity input[type='range'] {
    width: 100%;
    accent-color: #fd4b32;
    cursor: pointer;
  }

  /* Footer */
  .hud-footer {
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hud-hint {
    font-size: 0.68rem;
    color: #888888;
  }

  .hud-hint kbd {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 0.1rem 0.35rem;
    font-family: inherit;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 34rem) {
    .grid-hud {
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>
