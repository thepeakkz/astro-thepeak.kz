---
import { ClientRouter } from "astro:transitions";
import AnalyticsScripts from "@/components/DeferredAnalyticsScripts";
import GlobalPreloader from "@/components/GlobalPreloader";
import HeroVideoPreload from "@/components/HeroVideoPreload";
import { getOrganizationJsonLd, getWebsiteJsonLd, pageSeo, SITE_NAME, SITE_URL } from "@/lib/seo";
import GlobalRuntime from "@astro/components/GlobalRuntime";
import "@astro/styles/global.css";

type SeoConfig = {
  title: string;
  description: string;
  path: string;
  keywords?: readonly string[];
};

interface Props {
  jsonLd?: unknown | unknown[];
  noindex?: boolean;
  pageKind?: "default" | "home" | "site-development";
  seo?: SeoConfig;
}

const {
  jsonLd,
  noindex = false,
  pageKind = "default",
  seo = pageSeo.home,
} = Astro.props;
const canonical = new URL(seo.path, SITE_URL).toString();
const structuredData = [getOrganizationJsonLd(), getWebsiteJsonLd(), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const jsonLdText = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ru" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords?.length ? <meta name="keywords" content={seo.keywords.join(", ")} /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="https://static.tildacdn.pro/tild3334-3763-4662-a232-663137633465/favicon.svg" />
    {pageKind === "home" ? (
      <>
        <link rel="preload" as="image" href="/hero-mobile-poster-v2.webp" media="(max-width: 767px)" fetchpriority="high" />
        <link rel="preload" as="image" href="/hero-desktop-poster-v2.webp" media="(min-width: 768px)" fetchpriority="high" />
      </>
    ) : null}
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ru_KZ" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <script is:inline type="application/ld+json" set:html={jsonLdText} />
    <ClientRouter />
  </head>
  <body class="relative min-h-screen overflow-x-clip bg-white font-sans text-[#434343] antialiased selection:bg-[#FD4B32] selection:text-white">
    <AnalyticsScripts client:idle />
    <noscript>
      <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=869063512449970&ev=PageView&noscript=1" alt="" />
    </noscript>
    <GlobalRuntime client:idle transition:persist="global-runtime" />
    {pageKind === "site-development" ? <GlobalPreloader client:load /> : null}
    {pageKind === "home" ? <HeroVideoPreload client:idle /> : null}
    <main class="swiss-grid gap-y-0">
      <slot />
    </main>
  </body>
</html>
