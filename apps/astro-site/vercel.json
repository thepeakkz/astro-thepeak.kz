{
  "rewrites": [
    { "source": "/admin", "destination": "https://thepeak-kz.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://thepeak-kz.vercel.app/admin/:path*" },
    { "source": "/api/admin/:path*", "destination": "https://thepeak-kz.vercel.app/api/admin/:path*" },
    { "source": "/_next/:path*", "destination": "https://thepeak-kz.vercel.app/_next/:path*" }
  ],
  "redirects": [
    { "source": "/service/web", "destination": "/services/web", "permanent": true }
  ],
  "headers": [
    {
      "source": "/hero-:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
